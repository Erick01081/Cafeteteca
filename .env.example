# --- Supabase (base de datos + almacenamiento de fotos) ---
# 1. Crea un proyecto gratis en https://supabase.com
# 2. Ve a Project Settings → API y copia:
#    - "Project URL"          -> SUPABASE_URL
#    - "service_role" secret  -> SUPABASE_SERVICE_ROLE_KEY
#    ⚠️ La service_role key tiene acceso total: solo debe vivir en el servidor
#    (este archivo .env / variables de entorno de Vercel), NUNCA en código
#    de cliente ni en un repositorio público.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Nombre del bucket privado de Storage donde se guardan las fotos.
# Créalo en Supabase → Storage → New bucket → nombre "cafeteca-fotos".
SUPABASE_PHOTOS_BUCKET=cafeteca-fotos

# Obtén una clave gratuita en https://ocr.space/ocrapi/freekey.
# Se usa solo en el servidor; no la publiques ni la pongas en código de cliente.
OCR_SPACE_API_KEY=
